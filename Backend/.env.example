# PocketPilot backend environment variables.
#
# Copy this file to Backend/.env and fill in the values.
# Never commit Backend/.env: it is ignored by .gitignore.

# Secret used to sign authentication tokens (required for register/login).
# Generate your own, at least 32 characters, by running:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Each developer and each deployment should use a different secret.
# Leaving this empty makes authentication fail with a clear error.
JWT_SECRET_KEY=

# How long a login token stays valid, in minutes (1 to 1440). Default: 30.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: Ollama server used by /recommendations/ai.
# OLLAMA_URL=http://localhost:11434/v1
